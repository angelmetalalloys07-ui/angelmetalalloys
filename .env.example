# ============================================================
# SUPABASE CONFIGURATION
# ============================================================
# The URL to your Supabase project (Find this in Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# The public anon key for client-side operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The service role key for admin/server-side operations ONLY
# NEVER expose this to the client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# CLOUDINARY CONFIGURATION (Image Hosting)
# ============================================================
# Your Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name

# The upload preset name configured in Cloudinary (e.g., angel-metal-products)
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your-upload-preset

# API Key and Secret for server-side Cloudinary operations (e.g., deleting images)
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# RESEND CONFIGURATION (Email Sending)
# ============================================================
# Your Resend API key for sending transactional emails
RESEND_API_KEY=re_your-resend-key

# The email address that system emails should be sent FROM
# Must be a verified domain in your Resend account
RESEND_FROM_EMAIL=inquiries@yourdomain.com

# The email address that should RECEIVE the inquiry notifications
INQUIRY_NOTIFICATION_EMAIL=your-sales-email@gmail.com

# ============================================================
# ADMIN AUTHENTICATION
# ============================================================
# The master password required to access the /admin CRM panel
ADMIN_SECRET_PASSWORD=YourSecureAdminPassword123!

# A long, random 64-character hex string used to sign the JWT auth cookies
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_64_character_random_hex_string_here

# ============================================================
# SITE CONFIGURATION
# ============================================================
# The canonical URL of your deployed website (used for SEO, sitemaps, etc.)
# Examples: http://localhost:3000 (local) or https://www.angelmetalalloys.com (prod)
NEXT_PUBLIC_SITE_URL=https://www.angelmetalalloys.com
